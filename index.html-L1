<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova AI - Next Gen Intelligence</title>
    <link rel="stylesheet" href="style.css">
    <!-- Google Fonts for Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Sticky Navigation Bar -->
    <header class="navbar">
        <div class="logo">Nova<span>AI</span></div>
        <nav>
            <ul class="nav-links">
                <li><a href="#hero">Home</a></li>
                <li><a href="#features">Features</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#testimonials">Testimonials</a></li>
            </ul>
        </nav>
        <a href="#hero" class="btn btn-nav">Get Started</a>
    </header>

    <!-- Hero Section -->
    <section id="hero" class="hero-section">
        <div class="hero-content">
            <h1>Automate Your Workflow with Smart AI Solutions</h1>
            <p>Empower your business with cutting-edge artificial intelligence models designed to simplify operations, analyze data, and accelerate growth.</p>
            <div class="hero-buttons">
                <a href="#features" class="btn btn-primary">Explore Features</a>
                <a href="#about" class="btn btn-secondary">Learn More</a>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="section">
        <h2 class="section-title">Key Features</h2>
        <div class="card-grid">
            <div class="card">
                <div class="icon">⚡</div>
                <h3>Real-Time Analytics</h3>
                <p>Process massive streams of incoming data with ultra-low latency models tailored to your exact needs.</p>
            </div>
            <div class="card">
                <div class="icon">🔒</div>
                <h3>Secure Infrastructure</h3>
                <p>Enterprise-grade encryption and privacy controls keep your datasets protected at rest and in transit.</p>
            </div>
            <div class="card">
                <div class="icon">🚀</div>
                <h3>Seamless Integration</h3>
                <p>Plug into existing workflows effortless via versatile RESTful APIs and lightweight SDKs.</p>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section bg-alt">
        <div class="about-container">
            <div class="about-text">
                <h2 class="section-title left-align">About Nova AI</h2>
                <p>We build scalable artificial intelligence tools that help creators, engineers, and organizations build complex projects faster.</p>
                <p>Our goal is to remove repetitive technical friction so teams can focus on solving real-world challenges.</p>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="section">
        <h2 class="section-title">What Users Say</h2>
        <div class="card-grid">
            <div class="card testimonial-card">
                <p>"Nova AI completely streamlined our predictive models. Setup took less than an hour!"</p>
                <h4>- Alex R., Tech Lead</h4>
            </div>
            <div class="card testimonial-card">
                <p>"The UI and integration options are top-tier. Essential tool for modern dev stacks."</p>
                <h4>- Sarah M., Data Scientist</h4>
            </div>
        </div>
    </section>

    <!-- Footer Section -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-brand">
                <h3>Nova<span>AI</span></h3>
                <p>Building tomorrow's intelligent web.</p>
            </div>
            <div class="footer-links">
                <h4>Quick Links</h4>
                <ul>
                    <li><a href="#hero">Home</a></li>
                    <li><a href="#features">Features</a></li>
                    <li><a href="#about">About</a></li>
                </ul>
            </div>
            <div class="footer-social">
                <h4>Connect</h4>
                <div class="social-links">
                    <a href="#">GitHub</a>
                    <a href="#">LinkedIn</a>
                    <a href="#">Twitter</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 Nova AI Inc. All rights reserved.</p>
        </div>
    </footer>

</body>
</html>
