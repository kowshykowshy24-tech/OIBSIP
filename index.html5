<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Portfolio</title>

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- Navigation -->
    <header>
        <nav class="navbar">
            <h2 class="logo">MyPortfolio</h2>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#skills">Skills</a></li>
                <li><a href="#projects">Projects</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-text">
            <p class="intro">Hello, I'm</p>
            <h1>Your Name</h1>
            <h2>Web Developer</h2>

            <p>
                I am a passionate beginner web developer interested in
                creating clean, responsive and user-friendly websites.
            </p>

            <a href="#projects" class="btn">View My Projects</a>
        </div>

        <div class="profile">
            <div class="profile-placeholder">
                Your Photo
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section">
        <h2>About Me</h2>

        <p>
            I am a motivated student and aspiring web developer who enjoys
            learning HTML, CSS and JavaScript. I am interested in designing
            modern websites and improving my programming skills through
            practical projects.
        </p>

        <p>
            My goal is to continue learning web development and build
            useful, attractive and responsive websites.
        </p>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="section skills-section">
        <h2>My Skills</h2>

        <div class="skills-grid">
            <div class="skill-card">
                <h3>HTML5</h3>
                <p>Creating structured and semantic web pages.</p>
            </div>

            <div class="skill-card">
                <h3>CSS3</h3>
                <p>Designing responsive and attractive websites.</p>
            </div>

            <div class="skill-card">
                <h3>JavaScript</h3>
                <p>Adding interaction and functionality to websites.</p>
            </div>

            <div class="skill-card">
                <h3>Responsive Design</h3>
                <p>Building websites that work on different screen sizes.</p>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="section">
        <h2>My Projects</h2>

        <div class="projects-grid">

            <div class="project-card">
                <h3>Project 1 - Landing Page</h3>

                <p>
                    A responsive landing page created using HTML and CSS.
                    It includes navigation, a hero section and different
                    content sections.
                </p>

                <a href="#" class="project-btn">GitHub Link</a>
            </div>

            <div class="project-card">
                <h3>Project 2 - Temperature Converter</h3>

                <p>
                    A temperature converter website that converts values
                    between Celsius, Fahrenheit and Kelvin using JavaScript.
                </p>

                <a href="#" class="project-btn">GitHub Link</a>
            </div>

        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="section contact">
        <h2>Contact Me</h2>

        <p>
            I would love to connect with you. Feel free to contact me.
        </p>

        <div class="contact-info">
            <p><strong>Name:</strong> Your Name</p>
            <p><strong>Email:</strong> yourname@email.com</p>
            <p><strong>GitHub:</strong> github.com/yourusername</p>
            <p><strong>LinkedIn:</strong> linkedin.com/in/yourusername</p>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Your Name. All Rights Reserved.</p>
    </footer>

</body>
</html>
